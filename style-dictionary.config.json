{
  "source": ["tokens.json"],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "build/",
      "files": [
        {
          "destination": "style-dictionary.tokens.css",
          "format": "css/variables",
          "options": {
            "outputReferences": true
          },
          "selector": ":root"
        }
      ]
    }
  }
}

